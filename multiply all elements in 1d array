import java.util.*;
public class Zoro{
    public static void main(String[]args)
    {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int product = 1;
        for(int i=0;i<n;i++){
            int num = s.nextInt();
            product = product*num;
        }
        System.out.println(product);
    }
}
