import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
       Scanner s = new Scanner(System.in);
        int N;
        N = s.nextInt();
        int sum = 0;
        for(int i=0;i<N;i++){
            sum+=s.nextInt();
        }
        System.out.println(sum);
    }
}
