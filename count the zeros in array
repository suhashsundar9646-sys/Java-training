import java.util.*;
public class Zoro{
    public static void main(String[]args)
    {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        int count = 0;
        for(int i=0;i<n;i++){
            int num = s.nextInt();
            if(num == 0){
                count++;
            }
        }
        System.out.println(count);
    }
}
