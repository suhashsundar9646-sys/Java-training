import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int g,i;
        Scanner s = new Scanner(System.in);
        g = s.nextInt();
        int factorial = 1;
        for(i=1;i<=g;i++){
            factorial=factorial*i;
        }
        System.out.println(factorial);
        
    }
}
