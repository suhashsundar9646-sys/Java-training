import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int g,sum,i;
        Scanner s= new Scanner(System.in);
        g = s.nextInt();
        sum = 0;
        for( i=1;i<=g;i++){
            sum = sum+i;
        }
        System.out.println(sum);
    }
}
