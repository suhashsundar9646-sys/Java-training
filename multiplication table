import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
       
        int mul,n,i;
        Scanner s = new Scanner(System.in);
       n = s.nextInt();
        i = 1;
        mul= 0;
        for(i=1;i<=10;i++){
            mul=i*n;
        
        System.out.println(i+""+'*'+n+"="+mul);
    }}
}
