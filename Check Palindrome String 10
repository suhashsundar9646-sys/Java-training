import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String s = sc.next();   // fixed variable
        String rev = "";

        for(int i = s.length() - 1; i >= 0; i--){
            rev = rev + s.charAt(i);
        }

        if(s.equals(rev)){   // fixed equals()
            System.out.println("Palindrome");
        }
        else{
            System.out.println("Not Palindrome");  // fixed spelling
        }
    }
}
