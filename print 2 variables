import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Read integer
        int n = sc.nextInt();
        sc.nextLine(); // consume newline

        // Read string
        String s = sc.nextLine();

        // Print outputs
        System.out.println(n);
        System.out.println(s);

        sc.close();
    }
}
